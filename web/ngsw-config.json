{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.svg", "/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/config.js", "/assets/quran-text/**"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**"],
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**", "https://cdn.jsdelivr.net/npm/quran-json@3.1.2/**", "https://everyayah.com/**", "https://download.quranicaudio.com/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-quran",
      "urls": ["**/api/v1/quran/**"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 200, "maxAge": "30d", "timeout": "8s" }
    },
    {
      "name": "api-azkar",
      "urls": ["**/api/v1/azkar/categories**", "**/api/v1/azkar/today**"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 40, "maxAge": "7d", "timeout": "8s" }
    }
  ]
}
