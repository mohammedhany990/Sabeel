FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src ./src
RUN mvn -q -B package -DskipTests

FROM debian:bookworm-slim AS whisper-build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
ARG WHISPER_CPP_COMMIT=868e55578ea5f69550c046da22aefe11dc6e04c0
RUN git clone https://github.com/ggerganov/whisper.cpp.git /whisper.cpp \
    && git -C /whisper.cpp checkout ${WHISPER_CPP_COMMIT} \
    && cmake -S /whisper.cpp -B /whisper.cpp/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /whisper.cpp/build -j2 --config Release --target whisper-cli
ARG WHISPER_MODEL=ggml-base.bin
ARG WHISPER_MODEL_SHA256=60ed5bc3dd14eea856493d334349b405782ddcaf0028d4b5df4088345fba2efe
RUN curl -sL -o /model.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/${WHISPER_MODEL} \
    && echo "${WHISPER_MODEL_SHA256}  /model.bin" | sha256sum -c -

FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/target/recitation-service-*.jar app.jar
COPY --from=whisper-build /whisper.cpp/build/bin/whisper-cli /opt/whisper/whisper-cli
COPY --from=whisper-build /whisper.cpp/build/bin/libwhisper.so* /opt/whisper/
COPY --from=whisper-build /whisper.cpp/build/bin/libggml*.so* /opt/whisper/
COPY --from=whisper-build /model.bin /opt/whisper/model.bin
ENV LD_LIBRARY_PATH=/opt/whisper
EXPOSE 8091
ENTRYPOINT ["java", "-jar", "app.jar"]
